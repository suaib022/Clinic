# Copy to .env.local (local) or set in the host's environment settings. Names only: never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this site (used in links, payment callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth / background jobs
JWT_SECRET=
EXTRACTION_CRON_SECRET=

# Lab report vision (OpenRouter)
OPENROUTER_API_KEY=
EXTRACTION_MODEL=

# Aura voice assistant (ElevenLabs)
ELEVENLABS_API_KEY=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Payment (SSLCommerz; keep sandbox for demos)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true

# Optional
ANALYTICS_MIN_PATIENTS=

# DEV ONLY: never set these on a public site
# DSS_DEV_SEED=1
# DSS_TEST_PASSWORD=
# NEXT_PUBLIC_DEV_QUICK_LOGIN=1
